    {
      "cell_type": "code",
      "source": [
        "df['text'] = df['title'].fillna('') + ' ' + df['content'].fillna('')"
      ],
      "metadata": {
        "id": "fJxj5_l0pZZJ"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# 3. Custom text cleaner Transformer to use in pipeline\n",
        "class TextCleaner(TransformerMixin):\n",
        "    def transform(self, X, **transform_params):\n",
        "        return [self.clean_text(text) for text in X]\n",
        "\n",
        "    def fit(self, X, y=None, **fit_params):\n",
        "        return self\n",
        "\n",
        "    @staticmethod\n",
        "    def clean_text(text):\n",
        "        text = text.lower()  # Lowercase\n",
        "        text = re.sub(r'\\d+', '', text)  # Remove digits\n",
        "        text = re.sub(r'[^\\w\\s]', '', text)  # Remove punctuation\n",
        "        text = re.sub(r'\\s+', ' ', text)  # Remove extra spaces\n",
        "        text = text.strip()\n",
        "        return text\n"
      ],
      "metadata": {
        "id": "WyTtibTgpcn6"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# 4. Prepare stopwords list (English in this case)\n",
        "stop_words = stopwords.words('english')  # keep as a list, not a set"
      ],
      "metadata": {
        "id": "nJmdQPcNpe11"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "X_train, X_test, y_train, y_test = train_test_split(df['text'], df['category'], test_size=0.2, random_state=42), stratify=df["category"]"
      ],
      "metadata": {
        "id": "hpNGFSaPphYA"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# 6. Build a pipeline for cleaning, vectorizing, and classification\n",
        "pipeline = Pipeline([\n",
        "    ('tfidf', TfidfVectorizer(max_features=5000, stop_words=stop_words, ngram_range=(1,2))),\n",
        "    ('svm', LinearSVC())\n",
        "])\n"
      ],
      "metadata": {
        "id": "P-RIKS6qpjzv"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# 7. Train the model\n",
        "print(\"Training SVM classifier...\")\n",
        "pipeline.fit(X_train, y_train)"
      ],
